# Optional: set this to enable LLM-written blog prose (vidblog) and richer
# fallback answers (kgwiki) via the Anthropic API. Without it, vidblog uses a
# free rule-based writer and kgwiki prefers a local Ollama model if running,
# otherwise a free extractive fallback that quotes the transcript directly.
ANTHROPIC_API_KEY=

# Optional: only needed if your local Ollama isn't at the default location
# (docker-compose sets this automatically to http://ollama:11434).
# OLLAMA_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=qwen2.5:3b
# OLLAMA_EMBED_MODEL=nomic-embed-text
